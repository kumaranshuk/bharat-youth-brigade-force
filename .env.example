# ------------------------------------------------------------------
# Bhartiya Yuva Shakti Sangathan — environment variables
# Copy to .env.local and fill in. The site runs fully WITHOUT the
# database set (forms fall back to local file storage under ./.data).
# ------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="https://byssorg.com"

# Neon PostgreSQL connection string. When set, form submissions persist
# to Postgres via Drizzle. When unset, they persist to ./.data/*.json.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
